    }
    S('path',{d,fill:'none',stroke:series.color||COLORS.teal,'stroke-width':series.width||3,'stroke-linecap':'round','stroke-linejoin':'round',...(series.dash?{'stroke-dasharray':series.dash}:{})},svg);
  });
  (opt.markers||[]).forEach(pt=>{
    if(pt.x<xmin||pt.x>xmax||pt.y<ymin||pt.y>ymax)return;
    if(pt.vertical)S('line',{x1:px(pt.x),x2:px(pt.x),y1:py(pt.y),y2:H-m.b,stroke:pt.color||COLORS.orange,'stroke-dasharray':'4 5','stroke-width':1.5},svg);
    S('circle',{cx:px(pt.x),cy:py(pt.y),r:pt.r||6,fill:pt.color||COLORS.orange,class:'marker'},svg);
  });
