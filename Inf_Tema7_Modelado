// 8. Práctica de interpretación. Todos los datos y modelos son didácticos.
// Las soluciones se muestran solo por petición del estudiante.
const practGraphChoices=['Logaritmo en X','Logaritmo en Y','Logaritmo en X e Y','Término cuadrático','Término cúbico','Sin transformación'];
const practExercises=[
 {kind:'graph',curve:'logplus',correct:0,question:'Los datos muestran una relación creciente que se va aplanando. ¿Qué transformación en X podría ser útil?',context:'Se representa una muestra de observaciones individuales. Elige la opción más razonable.',solution:'El logaritmo en X puede representar una relación creciente con incrementos cada vez menores. Al representar Y frente a ln(X), los puntos siguen aproximadamente una recta.'},
 {kind:'graph',curve:'logminus',correct:0,question:'La relación es negativa y la caída se hace menos pronunciada. ¿Qué transformación en X podrías explorar?',context:'Observa la nube de puntos, no solo su tendencia general.',solution:'También con una relación negativa puede ser útil ln(X). Cambia el signo de la pendiente, pero la interpretación del coeficiente sigue siendo lineal–logarítmica.'},
 {kind:'graph',curve:'hist',correct:1,question:'La variable Y presenta una distribución muy asimétrica a la derecha. ¿Qué transformación de Y podría examinarse?',context:'Este gráfico es un histograma de Y, sin utilizar todavía ninguna variable X.',solution:'Aplicar ln(Y), si Y es estrictamente positiva, puede reducir la asimetría. La decisión requiere examinar después la adecuación del modelo; el histograma por sí solo no obliga a transformar.'},
 {kind:'graph',curve:'quadratic',correct:3,question:'Las observaciones muestran una U invertida. ¿Qué término añadirías al modelo?',context:'La relación aumenta hasta cierta zona y después disminuye.',solution:'Un término X² junto con X permite una parábola. Si el coeficiente de X² es negativo, la curvatura es hacia abajo. Ambos términos se interpretan conjuntamente.'},
 {kind:'graph',curve:'cubic',correct:4,question:'Los puntos sugieren una curva con dos cambios de dirección. ¿Qué término puede aportar más flexibilidad?',context:'La relación no parece representarse bien mediante una sola U.',solution:'Incorporar X³, junto con X y X² por jerarquía, permite formas más flexibles y dos posibles puntos de giro. Se interpreta el conjunto de los términos.'},
 {kind:'graph',curve:'linear',correct:5,question:'Los puntos se distribuyen aproximadamente alrededor de una recta. ¿Qué opción probarías primero?',context:'Considera únicamente la forma observada de la relación.',solution:'Una relación aproximadamente lineal puede modelarse inicialmente sin transformar. Después hay que comprobar el ajuste y los supuestos.'},
 {kind:'choice',question:'En una regresión, tipoCasa = +18,00 y Apartamento es la base. ¿Qué significa?',context:'Y es el precio por noche (€), sin transformar; no hay interacción con tipo.',formula:'Precio = β₀ + β₁ · tipoCasa + otros términos',opts:['La Casa cuesta, en promedio, 18,00 € más que un Apartamento con iguales características.','La Casa cuesta un 18 % más que un Apartamento.','El Apartamento cuesta 18,00 € más que la Casa.','El coeficiente indica el precio total de una Casa.'],correct:0,solution:'El coeficiente de la dummy representa una diferencia estimada respecto a la categoría base (Apartamento), manteniendo constantes las demás variables.'},
 {kind:'choice',question:'Una variable tiene p-valor = 0,50. ¿Qué conclusión corresponde con un nivel de significación α del 5 %?',context:'Se contrasta H₀: β = 0.',opts:['No se rechaza H₀; no hay evidencia suficiente de que el coeficiente poblacional sea diferente de cero.','El coeficiente poblacional está demostrado que es cero.','Hay un 50 % de probabilidad de que H₀ sea verdadera.','La variable es significativa al 5 %.'],correct:0,solution:'Como 0,50 > 0,05, no rechazamos H₀: β = 0. No demostrar diferencia de cero no equivale a demostrar que sea exactamente cero.'},
 {kind:'numeric',question:'Si Y está en euros y el coeficiente de ln(ingresos) es 240,00, ¿en cuántos euros cambia aproximadamente Y cuando los ingresos aumentan un 1 %?',context:'Modelo lineal–logarítmico, manteniendo constantes las demás variables.',formula:'Y = β₀ + 240,00 · ln(ingresos)',value:2.4,tolerance:.03,unit:'€',solution:'Con logaritmo solo en X, un aumento del 1 % se asocia aproximadamente con 0,01 × 240,00 = 2,40 € más en Y.'},
 {kind:'numeric',question:'¿Cuál es el cambio exacto estimado del gasto al pasar de 40 a 41 años?',context:'Calcula las dos predicciones y réstalas. Expresa el resultado en euros.',formula:'Gasto estimado = 300 + 200 · Edad − 2 · Edad²',value:38,tolerance:.01,unit:'€',solution:'A los 40 años: 5.100 €. A los 41 años: 5.138 €. La diferencia es 5.138 − 5.100 = 38,00 €. La derivada a los 40 años es 40 € por año, pero no es el cambio exacto entre 40 y 41.'},
 {kind:'numeric',question:'¿Cuál es el efecto de una hora más de estudio entre quienes reciben tutorías (T = 1)?',context:'Indica el cambio de nota por hora adicional de estudio.',formula:'Nota = 2 + 0,60 · Estudio + 0,80 · T + 0,25 · (Estudio × T)',value:.85,tolerance:.011,unit:'puntos por hora',solution:'Con tutorías, el efecto de estudio se obtiene sumando 0,60 + 0,25 = 0,85 puntos por cada hora adicional, manteniendo las demás variables constantes.'},
 {kind:'choice',question:'Si mantienes X³ en un modelo, ¿qué términos conservas por el principio de jerarquía?',context:'Supón que X³ se ha decidido mantener aunque los coeficientes de menor orden tengan p-valores mayores que 0,05.',opts:['X y X², además de X³.','Solo X³.','X², pero se elimina X.','Solo los términos individuales estadísticamente significativos.'],correct:0,solution:'La jerarquía de un polinomio cúbico incluye X, X² y X³. Los términos de orden inferior se conservan aunque no sean significativos por separado.'},
 {kind:'choice',question:'Si la interacción Edad × Tutorías se mantiene, ¿qué ocurre con los términos principales?',context:'La interacción es estadísticamente significativa, pero Edad no lo es individualmente.',opts:['Se conservan Edad y Tutorías junto con su interacción.','Se elimina Edad porque no es significativa.','Se elimina Tutorías y se mantiene solo la interacción.','La interacción reemplaza automáticamente a las otras variables.'],correct:0,solution:'Por jerarquía se mantienen ambos efectos principales al incluir la interacción. Sus p-valores individuales no obligan a eliminarlos.'},
 {kind:'numeric',question:'¿Cuál es el coeficiente estandarizado de Edad?',context:'Coeficiente original 50; DE(Edad) = 12; DE(Y) = 1.800. Redondea a tres decimales.',formula:'β estandarizado = b × DE(X) / DE(Y)',value:1/3,tolerance:.005,unit:'desviaciones estándar',solution:'50 × 12 / 1.800 = 0,333. Un aumento de una desviación estándar de Edad se asocia con 0,333 desviaciones estándar de Y, manteniendo constantes las demás variables. Este ejemplo supone un término lineal sin interacciones.'}
];
let practAt=0;
const practSaved=practExercises.map(()=>({choice:null,numeric:'',checked:false,shown:false,ok:false}));
function practDataset(name){
 if(name==='hist'){
  return Array.from({length:260},(_,i)=>({x:i,y:Math.exp(4.7+.65*normalNoise(i,7))}));
 }
 const data=[];
 for(let i=0;i<52;i++){
  const t=(i+.6)/52,n=sampleNoise(i,9),n2=sampleNoise(i,15);
  const x=(name==='logplus'||name==='logminus'||name==='power')?2+77*t:name==='quadratic'?3+54*t:name==='cubic'?12+58*t:3+75*t;
  let y;
  if(name==='logplus')y=160+115*Math.log(x)+30*n;
  else if(name==='logminus')y=950-135*Math.log(x)+30*n;
  else if(name==='power')y=42*Math.pow(x,.59)*Math.exp(.13*n);
  else if(name==='quadratic')y=260+38*x-.66*x*x+23*n;
  else if(name==='cubic')y=450+.025*Math.pow(x-41,3)-11*(x-41)+19*n2;
  else y=160+5.3*x+32*n;
  data.push({x,y:Math.max(1,y)});
 }
 return data;
}
function practGraphDraw(id,name,after=false){
 const points=practDataset(name);
 if(name==='hist'){histogramPlot(id,points.map(p=>after?Math.log(p.y):p.y),after?'ln(Y)':'Y original',14);return}
 let mapped=points,xLabel='X',yLabel='Y',line=null;
 if(after&&['logplus','logminus','power'].includes(name)){
  mapped=points.map(p=>({x:Math.log(p.x),y:name==='power'?Math.log(p.y):p.y}));
  xLabel='ln(X)';yLabel=name==='power'?'ln(Y)':'Y';
 }else if(after){
  if(name==='quadratic')line=x=>260+38*x-.66*x*x;
  if(name==='cubic')line=x=>450+.025*Math.pow(x-41,3)-11*(x-41);
  if(name==='linear')line=x=>160+5.3*x;
 }
 scatterPlot(id,mapped,{xLabel,yLabel,line});
}
function practRender(){
 const q=practExercises[practAt],r=practSaved[practAt],graph=q.kind==='graph';
 $('practKind').textContent=graph?'Identificar transformaciones a partir de observaciones':'Interpretar coeficientes y modelos';
 $('practQuestion').textContent=q.question;$('practContext').textContent=q.context;
 $('practFormula').hidden=!q.formula;if(q.formula)$('practFormula').textContent=q.formula;
 $('practChartWrap').hidden=!graph;
 if(graph)practGraphDraw('practChart',q.curve,false);
 $('practAnswerOptions').hidden=q.kind==='numeric';$('practNumericWrap').hidden=q.kind!=='numeric';
 if(q.kind==='numeric'){$('practNumeric').value=r.numeric;$('practNumUnit').textContent=' '+q.unit;}
 const opts=q.kind==='graph'?practGraphChoices:q.opts;
 $('practAnswerOptions').replaceChildren();
 if(q.kind!=='numeric')opts.forEach((op,i)=>{
  const b=document.createElement('button');b.textContent=op;b.className=r.choice===i?'chosen':'';
  if(r.checked||r.shown){b.classList.toggle('correct',i===q.correct);b.classList.toggle('wrong',r.choice===i&&i!==q.correct)}
  b.addEventListener('click',()=>{r.choice=i;r.checked=false;r.ok=false;practRender()});$('practAnswerOptions').append(b);
 });
 $('practFeedback').hidden=!r.checked;
 if(r.checked){$('practFeedback').className='answer '+(r.ok?'ok':'err');$('practFeedback').textContent=r.ok?'Correcto. Puedes consultar la explicación en «Ver solución».':'Revisa tu respuesta. Puedes consultar la solución y su explicación.'}
 $('practSolution').hidden=!r.shown;
 $('practReveal').textContent=r.shown?'Ocultar solución':'Ver solución';
 if(r.shown){
  $('practSolText').textContent=(q.kind==='numeric'?`Resultado: ${fmt(q.value, q.unit==='desviaciones estándar'?3:2)} ${q.unit}. `:q.kind==='graph'?`Opción orientativa: ${practGraphChoices[q.correct]}. `:`Respuesta correcta: ${q.opts[q.correct]} `)+q.solution;
  $('practSolvedChart').hidden=!graph;
  $('practSolvedChart').querySelector('p').innerHTML=['quadratic','cubic','linear'].includes(q.curve)?'<b>Curva de ajuste ilustrativa:</b> los mismos puntos y una función que reproduce su tendencia.':'<b>Después de la transformación:</b> los mismos datos representados con la transformación elegida.';
  if(graph)practGraphDraw('practAfter',q.curve,true);
 }
 const completed=practSaved.filter(x=>x.checked).length;
 $('practProgress').textContent=`Ejercicio ${practAt+1} de ${practExercises.length} · ${completed} respuestas comprobadas`;
 $('practProgressBar').style.width=`${completed/practExercises.length*100}%`;
 $('practCounter').textContent=`${practAt+1} / ${practExercises.length}`;
 $('practPrev').disabled=practAt===0;$('practNext').disabled=practAt===practExercises.length-1;
 [...$('practSections').children].forEach(b=>b.classList.toggle('on',b.dataset.pract===(practAt<6?'graphs':'coeffs')));
}
$('practNumeric').addEventListener('input',()=>{const r=practSaved[practAt];r.numeric=$('practNumeric').value;r.checked=false;r.ok=false;$('practFeedback').hidden=true});
$('practCheck').addEventListener('click',()=>{
 const q=practExercises[practAt],r=practSaved[practAt];
 if(q.kind==='numeric'){
  const raw=$('practNumeric').value.trim().replace(',','.');
  if(raw===''||!Number.isFinite(Number(raw))){$('practFeedback').hidden=false;$('practFeedback').className='answer err';$('practFeedback').textContent='Escribe un número antes de comprobar.';return}
  r.numeric=$('practNumeric').value;r.ok=Math.abs(Number(raw)-q.value)<=q.tolerance;
 }else{
  if(r.choice===null){$('practFeedback').hidden=false;$('practFeedback').className='answer err';$('practFeedback').textContent='Selecciona una respuesta antes de comprobar.';return}
  r.ok=r.choice===q.correct;
 }
 r.checked=true;practRender();
});
$('practReveal').addEventListener('click',()=>{const r=practSaved[practAt];r.shown=!r.shown;practRender()});
$('practPrev').addEventListener('click',()=>{practAt=Math.max(0,practAt-1);practRender()});
$('practNext').addEventListener('click',()=>{practAt=Math.min(practExercises.length-1,practAt+1);practRender()});
$('practSections').querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{practAt=b.dataset.pract==='graphs'?0:6;practRender()}));
practRender();

