// 2. Variables categóricas
const cats=['Africa','America','Asia','Europa'];
const catLabels={Africa:'África',America:'América',Asia:'Asia',Europa:'Europa'};
const catEffects={Africa:0,America:6.3,Asia:7.6,Europa:10.8};
const catColors={Africa:COLORS.teal,America:COLORS.orange,Asia:COLORS.purple,Europa:COLORS.green};
const catY=(gdp,c)=>47+5.4*Math.log(gdp)+catEffects[c];
function catUpdate(){
 const base=$('catBase').value,gdp=+$('catGDP').value;
 const others=cats.filter(c=>c!==base),cmp=$('catCompare'),old=cmp.value;
 cmp.replaceChildren();others.forEach(c=>{const opt=document.createElement('option');opt.value=c;opt.textContent=catLabels[c];cmp.add(opt)});
 if(others.includes(old))cmp.value=old;
 const choice=cmp.value,dif=catEffects[choice]-catEffects[base];
 $('catGDPVal').textContent=fmt(gdp*1000,0)+' €';
 const beta0=47+catEffects[base];
 $('catTheory').textContent='Vidaᵢ = β₀ + β₁ · ln(PIBpcᵢ) ' + others.map((c,i)=>'+ β'+['₂','₃','₄'][i]+' · continente'+catLabels[c]+'ᵢ').join(' ') + ' + uᵢ';
 const additional=others.map(c=>`${sign(catEffects[c]-catEffects[base],1)} · continente${catLabels[c]}`).join(' ');
 $('catFormula').innerHTML=`<span class="math">Ŷ = ${fmt(beta0,1)} + 5,4 · ln(PIBpc) ${additional}</span><div class="small">En esta ecuación, <code>continente${catLabels[choice]}</code> vale 1 cuando la observación pertenece a ${catLabels[choice]} y 0 en caso contrario. R muestra el nombre del factor seguido del nivel.</div>`;
 $('catInterpret').innerHTML=`<b>Comparación seleccionada:</b> ${catLabels[choice]} frente a ${catLabels[base]} (base). El coeficiente es <b>${sign(dif,1)} años</b>: a igual PIB per cápita, la esperanza de vida estimada en ${catLabels[choice]} es ${fmt(Math.abs(dif),1)} años <b>${dif>=0?'mayor':'menor'}</b> que en ${catLabels[base]}.`;
 $('catPrediction').innerHTML=`Para un PIB per cápita de <b>${fmt(gdp*1000,0)} €</b>: ${catLabels[base]} = <b>${fmt(catY(gdp,base),1)} años</b>; ${catLabels[choice]} = <b>${fmt(catY(gdp,choice),1)} años</b>.`;
 const table=$('catTable');table.tHead.replaceChildren();table.tBodies[0].replaceChildren();
 const trh=document.createElement('tr');['Continente',...others.map(c=>`continente${catLabels[c]}`)].forEach(txt=>{const th=document.createElement('th');th.textContent=txt;trh.append(th)});table.tHead.append(trh);
 cats.forEach(c=>{const tr=document.createElement('tr');if(c===base)tr.classList.add('hl');const td=document.createElement('td');td.textContent=catLabels[c]+(c===base?' · base':'');tr.append(td);others.forEach(other=>{const cell=document.createElement('td');cell.className='num';cell.textContent=String(c===other?1:0);tr.append(cell)});table.tBodies[0].append(tr)});
