function coefBars(id,values,labels,colors,precision=2){
 const svg=$(id);svg.replaceChildren();const W=680,H=330,m={l:63,r:24,t:26,b:55};
 const lo=Math.min(0,...values),hi=Math.max(0,...values),rng=Math.max(1e-9,hi-lo),pad=rng*.15;
 const min=lo-pad,max=hi+pad,ih=H-m.t-m.b,py=v=>m.t+(1-(v-min)/(max-min))*ih;
 for(let i=0;i<=4;i++){const val=min+(max-min)*i/4;S('line',{x1:m.l,x2:W-m.r,y1:py(val),y2:py(val),class:'gridline'},svg);S('text',{x:m.l-8,y:py(val)+4,'text-anchor':'end',class:'tick'},svg,fmt(val,precision))}
 S('line',{x1:m.l,x2:W-m.r,y1:py(0),y2:py(0),stroke:'#778E9B','stroke-width':1.5},svg);
 const each=(W-m.l-m.r)/3;
 values.forEach((v,i)=>{
   const bw=each*.34,barx=m.l+i*each+(each-bw)/2,y=Math.min(py(0),py(v)),h=Math.max(2,Math.abs(py(0)-py(v)));
   S('rect',{x:barx,y,width:bw,height:h,rx:4,fill:colors[i]},svg);
   S('text',{x:barx+bw/2,y:(v>=0?y-8:y+h+17),'text-anchor':'middle',fill:colors[i],'font-size':13,'font-weight':800},svg,fmt(v,precision));
   S('text',{x:m.l+i*each+each/2,y:H-25,'text-anchor':'middle',class:'axis-label'},svg,labels[i]);
 });
}
