  const head=document.createElement('div');head.innerHTML=`<b>${position+1}. ${q.q}</b>`;block.append(head);
  const answer=document.createElement('div');answer.style.color=good?'#287949':'#B74341';answer.textContent=(good?'✓ Correcta: ':'✗ Tu respuesta: ')+q.opts[sel];block.append(answer);
  if(!good){const correct=document.createElement('div');correct.textContent='Respuesta correcta: '+q.opts[q.a];block.append(correct)}
  const exp=document.createElement('div');exp.className='muted';exp.textContent=q.ex;block.append(exp);review.append(block);
 });
}
function examReset(shuffle=false){
 examQuestions=examSets[labModel];examAnswers=Array(examQuestions.length).fill(null);examAt=0;examDone=false;
 examOrder=examQuestions.map((_,i)=>i);examOptionOrders=examQuestions.map(q=>shuffledIndices(q.opts.length));
 if(shuffle){for(let i=examOrder.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[examOrder[i],examOrder[j]]=[examOrder[j],examOrder[i]]}}
 examRender();
}
$('examBack').addEventListener('click',()=>{examAt=Math.max(0,examAt-1);examRender()});
$('examNext').addEventListener('click',()=>{
 if(examAnswers[examOrder[examAt]]===null)return;
 if(examAt<examQuestions.length-1){examAt++;examRender();return}
 if(examAnswers.some(x=>x===null)){examAt=examOrder.findIndex(i=>examAnswers[i]===null);examRender();return}
 examDone=true;examShowResults();
});
$('examRetry').addEventListener('click',()=>examReset(true));
